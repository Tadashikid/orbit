# Copy to frontend/.env.local. Firebase web app config (Firebase console > Project settings > Your apps): these
# identify the project and are safe in a browser; they are not secrets. Empty = no Google / email sign-in buttons.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
