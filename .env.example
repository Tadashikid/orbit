# Copy to .env and fill in locally. .env is gitignored. NEVER commit real keys.
# Keys are only read by the Python backend. Never put them in frontend/ or in any VITE_* variable
# (Vite ships VITE_* values to the browser).

# Each teammate uses their OWN Gemini key during dev (free-tier rate limits are per key/project).
# The demo laptop uses a dedicated key that nobody else touches.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is overloaded (503) or slow; after these, the rules planner answers.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash

# Shared, small monthly quota. Only D makes live calls; everyone else runs on cached/seeded data.
SERPAPI_API_KEY=

# Frozen demo clock so "next weekend" always means the same dates (Sat 10 - Sun 11 Oct 2026).
ORBIT_TODAY=2026-10-08

# Demo login: one account, no Google sign-in. Pick your own password; while it's empty nobody can sign in.
# Changing it signs everyone out.
ORBIT_DEMO_EMAIL=lokihateshulk@gmail.com
ORBIT_DEMO_PASSWORD=

# Duffel flights in TEST mode (free, nothing real is booked): a token that starts with duffel_test_.
# Live tokens are refused. Empty = flights use the local sandbox.
DUFFEL_ACCESS_TOKEN=

# Google sign-in (Firebase Auth). Project id from Firebase > Project settings (public, not a secret). Until each user
# has their own data, only these emails may sign in (comma-separated; * = any Google account).
FIREBASE_PROJECT_ID=
ORBIT_ALLOWED_EMAILS=lokihateshulk@gmail.com  # or * for any verified Google account
# Keep conversations and bookings in Firestore instead of data/session/orbit.db: the service-account key file
# (Firebase console > Project settings > Service accounts > Generate new private key). Never commit it.
FIREBASE_SERVICE_ACCOUNT=
# Connect Google: Orbit reads your own calendar and inbox, read-only (backend/google_link.py).
# Google Cloud console > Google Auth Platform > Clients > Web application, Authorized redirect URIs:
# http://localhost:4173/api/google/callback (Connect Google) and http://localhost:8765/ (scripts/seed_demo_google.py).
# Enable the Gmail API and Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts each user's Google token at rest. Make one with:
#   .venv\Scripts\python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ORBIT_TOKEN_KEY=
# Booking confirmations: after you approve a booking, an email + calendar event through the Google Apps Script in
# scripts/orbit_notify.gs (setup steps at its top). URL = its Web app URL; SECRET = any long random string, the
# same one as the script's ORBIT_SECRET property. Leave empty for no confirmations.
ORBIT_NOTIFY_URL=
ORBIT_NOTIFY_SECRET=
# Booking alerts: one WhatsApp (or SMS) per booking you confirm or cancel, through Twilio (backend/alerts.py).
# Twilio console > Account info: SID + auth token. TWILIO_FROM: the WhatsApp sandbox number (+14155238886), or
# your Twilio trial number with ORBIT_ALERTS=sms. Each phone joins the sandbox once ("join <code>"). Empty = no alerts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+14155238886
ORBIT_ALERTS=whatsapp
# The sandbox's join phrase (Twilio console > Try out WhatsApp): the app shows it as a QR so a new phone joins in one tap.
ORBIT_WHATSAPP_JOIN=
