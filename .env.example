# Copy to .env and fill in locally. .env is gitignored. NEVER commit real keys.
# Keys are only read by the Python backend. Never put them in frontend/ or in any VITE_* variable
# (Vite ships VITE_* values to the browser).

# Each teammate uses their OWN Gemini key during dev (free-tier rate limits are per key/project).
# The demo laptop uses a dedicated key that nobody else touches.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is overloaded (503) or slow; after these, the rules planner answers.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash

# Shared, small monthly quota. Only D makes live calls; everyone else runs on cached/seeded data.
SERPAPI_API_KEY=

# Frozen demo clock so "next weekend" always means the same dates (Sat 10 - Sun 11 Oct 2026).
ORBIT_TODAY=2026-10-08

# Demo login: one account, no Google sign-in. Pick your own password; while it's empty nobody can sign in.
# Changing it signs everyone out.
ORBIT_DEMO_EMAIL=lokihateshulk@gmail.com
ORBIT_DEMO_PASSWORD=

# Duffel flights in TEST mode (free, nothing real is booked): a token that starts with duffel_test_.
# Live tokens are refused. Empty = flights use the local sandbox.
DUFFEL_ACCESS_TOKEN=
